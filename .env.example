# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis no provedor de hospedagem.

# Supabase (Project Settings > API). Use apenas a chave pública (publishable/anon), nunca a service_role.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Endereço público do site, usado no sitemap e nas prévias de compartilhamento.
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# Identificação do controlador exibida nas políticas e nos termos (obrigatório antes do deploy).
NEXT_PUBLIC_LEGAL_NAME=Razão social da BIJK
NEXT_PUBLIC_LEGAL_DOCUMENT=CNPJ 00.000.000/0000-00
NEXT_PUBLIC_LEGAL_ADDRESS=Endereço completo, cidade/UF
NEXT_PUBLIC_PRIVACY_EMAIL=privacidade@seudominio.com.br
NEXT_PUBLIC_DPO_NAME=Nome do encarregado (DPO)
